# ==============================================================================
# DocMind - Enterprise Document Intelligence Configuration
# ==============================================================================

# LLM Provider Configuration ("gemini" or "groq")
LLM_PROVIDER=gemini

# Google Gemini Configuration (Official google-genai SDK)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Configuration (Ultra-fast cloud inference)
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Embeddings & Re-ranking (Hugging Face / CPU/GPU - Zero API cost)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage and Persistence Directories
CHROMA_PERSIST_DIR=./data/chroma_db
BM25_PERSIST_DIR=./data/bm25
CACHE_DIR=./data/cache

# Text Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval & Re-ranking Parameters
TOP_K_DENSE=15
TOP_K_BM25=15
RRF_K=60
TOP_K_FINAL=5

# Maximum Allowed PDF Upload File Size in Megabytes
MAX_FILE_SIZE_MB=50


